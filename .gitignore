# Python
__pycache__/
*.pyc
*.pyo

# Data caches (large; synced via OneDrive, or re-fetchable via fetch_data.py / mt5_loader.py)
data_cache/
data_cache_mt5/

# Build/run logs
*.log

# Obsidian: keep graph.json (our color config) tracked, ignore the volatile workspace files
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache/

# Claude local (machine-specific permissions); keep settings.json (shared hooks) tracked
.claude/settings.local.json

# OS cruft
Thumbs.db
Desktop.ini
.DS_Store

# Live config holds a broker password (per-machine secret). Template is committed
# as edgelab/live/config_live.example.yaml.
edgelab/live/config_live.yaml

# Crypto data cache (Yahoo daily; re-fetchable) — like the other data_cache dirs
data_cache_crypto/

# Generated / regenerable outputs (arXiv corpus, report images, live logs & journals)
edgelab/research/_out/
edgelab/reports/_out/
edgelab/live/_out/
edgelab/data/_cache_yahoo/
