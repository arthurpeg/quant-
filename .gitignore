# Python
__pycache__/
*.pyc
*.pyo

# Data caches (large; synced via OneDrive, or re-fetchable via fetch_data.py / mt5_loader.py)
data_cache/
data_cache_mt5/

# Build/run logs
*.log

# Obsidian: keep graph.json (our color config) tracked, ignore the volatile workspace files
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache/

# Claude local (machine-specific permissions); keep settings.json (shared hooks) tracked
.claude/settings.local.json

# OS cruft
Thumbs.db
Desktop.ini
.DS_Store

# Live config holds a broker password (per-machine secret). Template is committed
# as edgelab/live/config_live.example.yaml.
edgelab/live/config_live.yaml

# Crypto data cache (Yahoo daily; re-fetchable) — like the other data_cache dirs
data_cache_crypto/

# Generated / regenerable outputs (arXiv corpus, report images, live logs & journals)
edgelab/research/_out/
edgelab/reports/_out/
edgelab/live/_out/
edgelab/data/_cache_yahoo/

# Root convenience copies of the HTML reports (versioned copies live in edgelab/reports/)
/RAPPORT_backtest_portefeuille.html
/RAPPORT_monte_carlo.html

# Campaign outputs (regenerable): corpus sweeps, battery runs, per-asset CSVs. 47 MB and
# rebuilt by scratchpad/battery_*.py — the wiki links to the scripts, not to these blobs.
scratchpad/_inx/

# crosslab (momentum cross-sectionnel G8) : 1,4 Go de M1 des 28 paires, re-tirable
# par `python -m crosslab.fetch`, et les parquets de grille, re-generables par
# `python -m crosslab.run`. Le rapport et le code, eux, sont suivis.
data_cache_fx28/
crosslab_grid/
fx28_*.log

# swinglab : donnees et artefacts regenerables (fetch -> costs -> run -> validate)
data_cache_swing/
swinglab/_brackets/
swinglab/_out/
# la config live peut porter des reglages propres a la machine ; le modele est commite
swinglab/live_config.json

# research/ (phase 1, porte IC) : 332 Mo de parquets MT5 M5/M15/H1/H4 et les
# grilles d'IC, tous re-tirables par `python research/scripts/04_run_pipeline.py`.
# Les livrables (validated_hypotheses.json, rapport_ic_gate.md) et le code sont suivis.
research/data/*.parquet
research/data/ic_results*.parquet
